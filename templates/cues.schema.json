{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "motion-craft cues",
  "description": "Single source of timing contract for the Remotion composition, audio scripts, subtitles, and QA.",
  "type": "object",
  "required": ["fps", "width", "height", "dur", "frames", "bounds", "scenes", "transition_plan", "sfx", "music"],
  "properties": {
    "fps": {"type": "number", "exclusiveMinimum": 0},
    "width": {"type": "integer", "exclusiveMinimum": 0},
    "height": {"type": "integer", "exclusiveMinimum": 0},
    "dur": {"type": "number", "exclusiveMinimum": 0, "description": "total duration in seconds, covering the full audio"},
    "frames": {"type": "integer", "exclusiveMinimum": 0, "description": "ceil(dur * fps)"},
    "bounds": {
      "type": "array",
      "description": "scene boundaries in seconds (ascending, starting at 0, ending at ~dur)",
      "items": {"type": "number", "minimum": 0}
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "start", "end", "entrance"],
        "properties": {
          "id": {"type": "string"},
          "start": {"type": "number", "minimum": 0},
          "end": {"type": "number", "exclusiveMinimum": 0},
          "entrance": {"$ref": "#/definitions/cue"},
          "mainActions": {
            "type": "array",
            "description": "at least 2 action beats after the entrance for scenes >= 3 seconds; at least 1 for short scenes",
            "items": {"$ref": "#/definitions/cue"}
          },
          "continueAction": {"$ref": "#/definitions/cue"},
          "exit": {"$ref": "#/definitions/cue"},
          "handoff": {"type": "string", "description": "connecting object/direction to the next scene"}
        }
      }
    },
    "transition_plan": {
      "type": "array",
      "description": "one entry per scene boundary",
      "items": {
        "type": "object",
        "required": ["at", "mechanism", "reason"],
        "properties": {
          "at": {"type": "number", "minimum": 0},
          "mechanism": {"type": "string", "description": "handoff | match-cut | morph | layout-shift | camera-move | iris | wipe | occlusion: must not be identical on two consecutive boundaries"},
          "duration": {"type": "number", "exclusiveMinimum": 0},
          "connector": {"type": "string", "description": "connecting object"},
          "direction": {"type": "string"},
          "reason": {"type": "string"},
          "sfx": {"type": "string"}
        }
      }
    },
    "words": {
      "type": "array",
      "description": "valid alignment result (word timings)",
      "items": {
        "type": "object",
        "required": ["word", "start", "end"],
        "properties": {
          "word": {"type": "string", "minLength": 1},
          "start": {"type": "number", "minimum": 0},
          "end": {"type": "number", "exclusiveMinimum": 0}
        }
      }
    },
    "captions": {"type": "array", "description": "phrases/sentences grouped from words; free format but consistent"},
    "voiceover": {
      "type": "object",
      "description": "optional: modes B/C/D only; absent in mode A. For muse-tts: wordTimings absent, per-segment timing lives in segmentTimings.",
      "required": ["source"],
      "properties": {
        "audioFile": {"type": "string"},
        "source": {"enum": ["elevenlabs", "whisperx", "user-supplied", "muse-tts"]},
        "modelId": {"type": "string"},
        "voiceId": {"type": "string"},
        "wordTimings": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["word", "start", "end"],
            "properties": {
              "word": {"type": "string"},
              "start": {"type": "number"},
              "end": {"type": "number"}
            }
          }
        },
        "segmentTimings": {
          "type": "array",
          "description": "per-segment timing for muse-tts (mode D): each segment duration is measured with ffprobe, cumulative offsets become the segment boundaries",
          "items": {
            "type": "object",
            "required": ["text", "start", "end"],
            "properties": {
              "text": {"type": "string", "minLength": 1},
              "file": {"type": "string"},
              "start": {"type": "number", "minimum": 0},
              "end": {"type": "number", "exclusiveMinimum": 0}
            }
          }
        },
        "sourceTimestamps": {"type": "string", "description": "path/trace of the original source timestamps so they stay traceable"}
      }
    },
    "ev": {"type": "array", "description": "visual cues; free format but the visual and QA consumers must use the same contract", "items": {"type": "object"}},
    "sfx": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["t", "type"],
        "properties": {
          "t": {"type": "number", "minimum": 0},
          "type": {"type": "string"},
          "gain": {"type": "number"},
          "pan": {"type": "number", "minimum": -1, "maximum": 1},
          "d": {"type": "number", "exclusiveMinimum": 0},
          "f": {"type": "number"},
          "f0": {"type": "number"},
          "f1": {"type": "number"},
          "step": {"type": "number", "exclusiveMinimum": 0}
        }
      }
    },
    "music": {
      "type": "object",
      "required": ["bpm", "bars", "final"],
      "properties": {
        "bpm": {"type": "number", "exclusiveMinimum": 0},
        "bars": {"type": "array", "minItems": 1, "items": {"type": "string"}, "description": "chord progression per bar, e.g. ['Am','F','C','G']"},
        "final": {"type": "number", "description": "final second of the music section"},
        "finalChord": {"type": "string"},
        "breaks": {"type": "array", "items": {"type": "array", "items": {"type": "number"}, "minItems": 2, "maxItems": 2}},
        "clapFrom": {"type": "number"},
        "hatFrom": {"type": "number"},
        "arpFrom": {"type": "number"},
        "build": {"type": "array", "items": {"type": "number"}, "maxItems": 2}
      }
    },
    "beatGrid": {
      "type": "object",
      "description": "optional: measured beat grid from the plan (section 3.2b); bpm must equal music.bpm",
      "properties": {
        "bpm": {"type": "number", "exclusiveMinimum": 0},
        "beatsPerBar": {"type": "integer", "minimum": 1},
        "offsetS": {"type": "number", "minimum": 0},
        "events": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["t", "beat", "alignment"],
            "properties": {
              "t": {"type": "number", "minimum": 0},
              "beat": {"type": "integer", "minimum": 0},
              "alignment": {"enum": ["on-grid", "off-beat"]},
              "reason": {"type": "string"}
            }
          }
        }
      }
    },
    "styleExceptions": {
      "type": "object",
      "description": "optional: Phase 4 style exception record (section 4.1); absent means the standard hook rule applies",
      "properties": {
        "hookStyle": {"enum": ["standard", "sparse"]},
        "firstVisualEventS": {"type": "number", "minimum": 0},
        "brandEndCard": {"type": "boolean"},
        "format": {"type": "string"}
      }
    }
  },
  "definitions": {
    "cue": {
      "type": "object",
      "required": ["t"],
      "properties": {
        "t": {"type": "number", "minimum": 0, "description": "start time in seconds"},
        "id": {"type": "string"},
        "action": {"type": "string", "description": "concrete visual action, not just 'zoom'/'fade'"},
        "duration": {"type": "number", "exclusiveMinimum": 0}
      }
    }
  }
}
