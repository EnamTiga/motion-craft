{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "motion-craft cues",
  "description": "Kontrak sumber timing tunggal untuk komposisi Remotion, skrip audio, subtitle, dan QA.",
  "type": "object",
  "required": ["fps", "width", "height", "dur", "frames", "bounds", "scenes", "transition_plan", "sfx", "music"],
  "properties": {
    "fps": {"type": "number", "exclusiveMinimum": 0},
    "width": {"type": "integer", "exclusiveMinimum": 0},
    "height": {"type": "integer", "exclusiveMinimum": 0},
    "dur": {"type": "number", "exclusiveMinimum": 0, "description": "durasi total dalam detik, mencakup audio utuh"},
    "frames": {"type": "integer", "exclusiveMinimum": 0, "description": "ceil(dur * fps)"},
    "bounds": {
      "type": "array",
      "description": "batas scene dalam detik (naik, mulai 0, berakhir ~dur)",
      "items": {"type": "number", "minimum": 0}
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "start", "end", "entrance"],
        "properties": {
          "id": {"type": "string"},
          "start": {"type": "number", "minimum": 0},
          "end": {"type": "number", "exclusiveMinimum": 0},
          "entrance": {"$ref": "#/definitions/cue"},
          "mainActions": {
            "type": "array",
            "description": "minimal 2 beat aksi setelah entrance untuk scene >= 3 detik; minimal 1 untuk scene pendek",
            "items": {"$ref": "#/definitions/cue"}
          },
          "continueAction": {"$ref": "#/definitions/cue"},
          "exit": {"$ref": "#/definitions/cue"},
          "handoff": {"type": "string", "description": "objek/arah penghubung ke scene berikutnya"}
        }
      }
    },
    "transition_plan": {
      "type": "array",
      "description": "satu entri per batas antar scene",
      "items": {
        "type": "object",
        "required": ["at", "mechanism", "reason"],
        "properties": {
          "at": {"type": "number", "minimum": 0},
          "mechanism": {"type": "string", "description": "handoff | match-cut | morph | layout-shift | camera-move | iris | wipe | occlusion — tidak boleh identik pada dua batas berturut-turut"},
          "duration": {"type": "number", "exclusiveMinimum": 0},
          "connector": {"type": "string", "description": "objek penghubung"},
          "direction": {"type": "string"},
          "reason": {"type": "string"},
          "sfx": {"type": "string"}
        }
      }
    },
    "words": {
      "type": "array",
      "description": "hasil alignment valid (word timings)",
      "items": {
        "type": "object",
        "required": ["word", "start", "end"],
        "properties": {
          "word": {"type": "string", "minLength": 1},
          "start": {"type": "number", "minimum": 0},
          "end": {"type": "number", "exclusiveMinimum": 0}
        }
      }
    },
    "captions": {"type": "array", "description": "frasa/kalimat hasil pengelompokan words; format bebas tapi konsisten"},
    "voiceover": {
      "type": "object",
      "description": "opsional — hanya mode B/C; absen pada mode A",
      "required": ["source"],
      "properties": {
        "audioFile": {"type": "string"},
        "source": {"enum": ["elevenlabs", "whisperx", "user-supplied"]},
        "modelId": {"type": "string"},
        "voiceId": {"type": "string"},
        "wordTimings": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["word", "start", "end"],
            "properties": {
              "word": {"type": "string"},
              "start": {"type": "number"},
              "end": {"type": "number"}
            }
          }
        },
        "sourceTimestamps": {"type": "string", "description": "path/jejak timestamp sumber asli agar dapat ditelusuri"}
      }
    },
    "ev": {"type": "array", "description": "cue visual; format bebas tapi konsumen visual & QA harus memakai kontrak sama", "items": {"type": "object"}},
    "sfx": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["t", "type"],
        "properties": {
          "t": {"type": "number", "minimum": 0},
          "type": {"type": "string"},
          "gain": {"type": "number"},
          "pan": {"type": "number", "minimum": -1, "maximum": 1},
          "d": {"type": "number", "exclusiveMinimum": 0},
          "f": {"type": "number"},
          "f0": {"type": "number"},
          "f1": {"type": "number"},
          "step": {"type": "number", "exclusiveMinimum": 0}
        }
      }
    },
    "music": {
      "type": "object",
      "required": ["bpm", "bars", "final"],
      "properties": {
        "bpm": {"type": "number", "exclusiveMinimum": 0},
        "bars": {"type": "array", "minItems": 1, "items": {"type": "string"}, "description": "progresi akor per bar, mis. ['Am','F','C','G']"},
        "final": {"type": "number", "description": "detik akhir bagian musik"},
        "finalChord": {"type": "string"},
        "breaks": {"type": "array", "items": {"type": "array", "items": {"type": "number"}, "minItems": 2, "maxItems": 2}},
        "clapFrom": {"type": "number"},
        "hatFrom": {"type": "number"},
        "arpFrom": {"type": "number"},
        "build": {"type": "array", "items": {"type": "number"}, "maxItems": 2}
      }
    }
  },
  "definitions": {
    "cue": {
      "type": "object",
      "required": ["t"],
      "properties": {
        "t": {"type": "number", "minimum": 0, "description": "waktu mulai dalam detik"},
        "id": {"type": "string"},
        "action": {"type": "string", "description": "tindakan visual konkret, bukan hanya 'zoom'/'fade'"},
        "duration": {"type": "number", "exclusiveMinimum": 0}
      }
    }
  }
}
